# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=colle_ton_token_ici

# Application ID du bot (Developer Portal > General Information > Application ID)
CLIENT_ID=

# ID de ton serveur (clic droit sur le serveur > Copier l'identifiant)
GUILD_ID=

# ID du rôle "Non vérifié" donné automatiquement à l'arrivée
ROLE_NON_VERIFIE=

# ID du rôle "Membre" donné après réussite du captcha
ROLE_MEMBRE=

# ID du rôle "Staff/Admin" autorisé à gérer les commandes/tickets
ROLE_STAFF=

# ID du salon où le message de vérification (captcha) est envoyé
SALON_VERIFICATION=

# ID du salon "tour du serveur" (message d'accueil avec les liens des salons)
SALON_ACCUEIL=

# ID des salons cités dans le tour (catalogue, historique, commande, suivi, paiement)
SALON_CATALOGUE=
SALON_HISTORIQUE=
SALON_COMMANDE=
SALON_SUIVI_COMMANDE=
SALON_PAIEMENT=

# ID de la catégorie où seront créés les tickets de commande
CATEGORIE_TICKETS=

# ID du salon "tableau clients" (liste des commandes à traiter)
SALON_TABLEAU_CLIENTS=
